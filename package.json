{
  "name": "taskbean-docs",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mint dev --no-open",
    "validate": "mint validate",
    "check:links": "mint broken-links --check-anchors --check-snippets",
    "check:external-links": "mint broken-links --check-anchors --check-snippets --check-external",
    "check:a11y": "mint a11y",
    "check": "npm run validate && npm run check:links && npm run check:a11y"
  },
  "devDependencies": {
    "mint": "^4.2.730"
  }
}
