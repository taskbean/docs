{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Taskbean",
  "description": "Local-first task management for developers and coding agents.",
  "colors": {
    "primary": "#9A4A00",
    "light": "#E8863C",
    "dark": "#9D4D00"
  },
  "background": {
    "color": {
      "dark": "#1A120E",
      "light": "#FAF6F1"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Fraunces",
      "weight": 700
    },
    "body": {
      "family": "Sora"
    }
  },
  "favicon": "/images/taskbean-favicon.png",
  "logo": {
    "light": "/images/taskbean-wordmark-light.png",
    "dark": "/images/taskbean-wordmark-dark.png",
    "href": "/"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/architecture",
              "concepts/glossary"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/installation",
              "cli/lifecycle",
              "cli/reporting",
              "cli/projects-workspaces",
              "cli/agent-skill",
              "cli/reference"
            ]
          },
          {
            "group": "Desktop app",
            "pages": [
              "app/getting-started",
              "app/configuration",
              "app/telemetry",
              "app/troubleshooting"
            ]
          },
          {
            "group": "Chronicle",
            "pages": [
              "chronicle/overview",
              "chronicle/cli-workflow",
              "chronicle/app-workflow"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/api",
              "reference/privacy-storage",
              "reference/environment-variables"
            ]
          }
        ]
      },
      {
        "tab": "Releases",
        "href": "https://github.com/taskbean/taskbean/releases"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://taskbean.ai",
          "icon": "globe"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/taskbean/taskbean",
          "icon": "github"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "How it works",
        "href": "https://taskbean.ai/how-it-works.html"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/taskbean/taskbean"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/taskbean",
      "website": "https://taskbean.ai"
    }
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.taskbean.ai",
      "og:locale": "en_US"
    },
    "indexing": "navigable"
  },
  "metadata": {
    "timestamp": true
  },
  "search": {
    "prompt": "Search Taskbean documentation..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "mcp",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "markdown": {
    "instructions": [
      "Treat taskbean/taskbean as the source of truth for product behavior.",
      "Use the canonical Project, Workspace, Agent Session, Task, and Unassigned Work terminology from the glossary.",
      "Do not infer that Windows-specific desktop features apply to the cross-platform CLI."
    ]
  },
  "styling": {
    "codeblocks": "system"
  },
  "redirects": [
    {
      "source": "/getting-started/installation",
      "destination": "/cli/installation",
      "permanent": true
    },
    {
      "source": "/getting-started/quick-start",
      "destination": "/quickstart",
      "permanent": true
    },
    {
      "source": "/getting-started/prerequisites",
      "destination": "/quickstart",
      "permanent": true
    },
    {
      "source": "/using-taskbean/ai-commands",
      "destination": "/app/getting-started",
      "permanent": true
    },
    {
      "source": "/using-taskbean/reminders",
      "destination": "/app/configuration",
      "permanent": true
    },
    {
      "source": "/using-taskbean/file-extraction",
      "destination": "/app/getting-started",
      "permanent": true
    },
    {
      "source": "/using-taskbean/model-switching",
      "destination": "/app/configuration",
      "permanent": true
    },
    {
      "source": "/using-taskbean/themes",
      "destination": "/app/configuration",
      "permanent": true
    },
    {
      "source": "/configuration/settings",
      "destination": "/app/configuration",
      "permanent": true
    },
    {
      "source": "/configuration/pwa",
      "destination": "/app/getting-started",
      "permanent": true
    },
    {
      "source": "/configuration/nerd-mode",
      "destination": "/app/telemetry",
      "permanent": true
    },
    {
      "source": "/development/project-structure",
      "destination": "/concepts/architecture",
      "permanent": true
    },
    {
      "source": "/development/running-tests",
      "destination": "/app/getting-started",
      "permanent": true
    },
    {
      "source": "/development/contributing",
      "destination": "/concepts/architecture",
      "permanent": true
    },
    {
      "source": "/help/troubleshooting",
      "destination": "/app/troubleshooting",
      "permanent": true
    },
    {
      "source": "/help/known-issues",
      "destination": "/app/troubleshooting",
      "permanent": true
    },
    {
      "source": "/development",
      "destination": "/app/getting-started",
      "permanent": true
    },
    {
      "source": "/api-reference/introduction",
      "destination": "/reference/api",
      "permanent": true
    }
  ]
}
